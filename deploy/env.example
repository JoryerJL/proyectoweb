# Copy to .env in the project root and fill in the values. Never commit the real .env.
#   cp deploy/env.example .env
# Used by docker-compose.prod.yml (env_file + variable interpolation).
# Local development needs NO variables: defaults in canaco/settings.py apply.

# --- Django ------------------------------------------------------------------
# Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-generate-a-long-random-value
# Must be false in production (the app refuses to start with DEBUG off and the default key).
DJANGO_DEBUG=false
# Comma-separated hostnames/IPs that serve the site (EC2 public IP or domain).
DJANGO_ALLOWED_HOSTS=203.0.113.10,example.com
# Comma-separated origins WITH scheme. Required for logins/forms behind a proxy.
# Include the port if it is not 80/443, e.g. http://203.0.113.10:8088
DJANGO_CSRF_TRUSTED_ORIGINS=http://203.0.113.10,https://example.com

# --- HTTPS (the CDK bootstrap sets these to true; keep false for plain-HTTP tests) --
# Trust X-Forwarded-Proto from the reverse proxy (nginx).
DJANGO_USE_PROXY_SSL_HEADER=false
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SESSION_COOKIE_SECURE=false
DJANGO_CSRF_COOKIE_SECURE=false
# 0 disables HSTS. Start low (e.g. 3600) when enabling.
DJANGO_SECURE_HSTS_SECONDS=0

# --- Database (host and port are set by the compose file) -----------------------
DB_NAME=canaco
DB_USER=canaco
DB_PASSWORD=change-me-strong-db-password

# --- Container image / runtime -------------------------------------------------
# Image to run. IMAGE_TAG can be "latest", a short commit SHA, etc. (rollbacks).
IMAGE=ghcr.io/joryerjl/proyectoweb
IMAGE_TAG=latest
# Host ports published by nginx.
HTTP_PORT=80
HTTPS_PORT=443
# Set to 1 to load demo news at startup (idempotent).
RUN_SEED=0
