# Copy to .env in the project root and fill in the values. Never commit the real .env.
#   cp deploy/env.example .env
# Used by docker-compose.prod.yml (env_file + variable interpolation).
# Local development needs NO variables: defaults in canaco/settings.py apply.

# --- Django ------------------------------------------------------------------
# Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me-generate-a-long-random-value
# Defaults to false when unset. Only set it to true for local development.
# With DEBUG off the app refuses to start with a missing or default secret key.
DJANGO_DEBUG=false
# Comma-separated hostnames/IPs that serve the site (EC2 public IP or domain).
DJANGO_ALLOWED_HOSTS=203.0.113.10,example.com
# Comma-separated origins WITH scheme. Required for logins/forms behind a proxy.
# Include the port if it is not 80/443, e.g. http://203.0.113.10:8088
DJANGO_CSRF_TRUSTED_ORIGINS=http://203.0.113.10,https://example.com

# Public domain (no scheme) used in sitemap.xml. Applied at container start by
# `manage.py set_site_domain`; leave empty to keep the current Site domain.
DJANGO_SITE_DOMAIN=example.com
# Log level for the django and home loggers (stderr, captured by Docker).
DJANGO_LOG_LEVEL=INFO

# --- HTTPS (the CDK bootstrap sets these to true; keep false for plain-HTTP tests) --
# Trust X-Forwarded-Proto from the reverse proxy (nginx).
DJANGO_USE_PROXY_SSL_HEADER=false
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_SESSION_COOKIE_SECURE=false
DJANGO_CSRF_COOKIE_SECURE=false
# 0 disables HSTS. Start low (e.g. 3600) when enabling.
DJANGO_SECURE_HSTS_SECONDS=0
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=false
DJANGO_SECURE_HSTS_PRELOAD=false

# --- Email (contact form notifications) ---------------------------------------
# Inbox that receives contact-form messages. Leave empty to only store them in the database.
DJANGO_CONTACT_EMAIL=
# SMTP settings. Without DJANGO_EMAIL_HOST the SMTP backend tries localhost:25.
DJANGO_EMAIL_HOST=smtp.example.com
DJANGO_EMAIL_PORT=587
DJANGO_EMAIL_HOST_USER=
DJANGO_EMAIL_HOST_PASSWORD=
DJANGO_EMAIL_USE_TLS=true
DJANGO_DEFAULT_FROM_EMAIL=Canaco <no-reply@example.com>

# --- Database (host and port are set by the compose file) -----------------------
DB_NAME=canaco
DB_USER=canaco
DB_PASSWORD=change-me-strong-db-password

# --- Container image / runtime -------------------------------------------------
# Image to run. IMAGE_TAG can be "latest", a short commit SHA, etc. (rollbacks).
IMAGE=ghcr.io/joryerjl/proyectoweb
IMAGE_TAG=latest
# Host ports published by nginx.
HTTP_PORT=80
HTTPS_PORT=443
# Set to 1 to load demo news at startup (idempotent).
RUN_SEED=0

# Shared cache directory for the sidebar cache (all gunicorn workers must see it).
# DJANGO_CACHE_DIR=/tmp/canaco_cache
